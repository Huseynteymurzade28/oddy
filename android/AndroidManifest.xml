<?xml version="1.0" encoding="utf-8"?>
<!--
	Lumi & the Hollow for Android. A NativeActivity: there is no Java in the app, raylib's
	native glue starts the game from `liboddy.so`. See tools/build_android.sh.

	Predictive back is switched off so Back reaches the game as a key (it
	pauses, and Back again on the pause card leaves) instead of closing it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	package="com.flear.lumi"
	android:versionCode="1"
	android:versionName="1.0">

	<uses-feature android:glEsVersion="0x00020000" android:required="true" />
	<uses-permission android:name="android.permission.VIBRATE" />
	<uses-feature android:name="android.hardware.touchscreen" android:required="false" />

	<application
		android:label="@string/app_name"
		android:icon="@mipmap/ic_launcher"
		android:hasCode="false"
		android:allowBackup="false"
		android:appCategory="game"
		android:isGame="true"
		android:enableOnBackInvokedCallback="false">
		<activity
			android:name="android.app.NativeActivity"
			android:exported="true"
			android:screenOrientation="sensorLandscape"
			android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|density|keyboard|navigation"
			android:launchMode="singleTask"
			android:resizeableActivity="false"
			android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
			<meta-data android:name="android.app.lib_name" android:value="oddy" />
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity>
	</application>
</manifest>
